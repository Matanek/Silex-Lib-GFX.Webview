{
  "name": "GFX.WebView",
  "version": "0.4.0",
  "description": "Embed system HTML, CSS, and JavaScript WebViews in GFX windows.",
  "authors": ["Matanek"],
  "requires": { "silex": ">=0.40.0" },
  "dependencies": {
    "GFX": "^0.37.0",
    "JSON": "^0.1.0",
    "STD": "^0.16.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "System": {
          "frameworks": ["Cocoa", "WebKit"],
          "libraries": ["objc"]
        }
      }
    },
    "linux-x64": {
      "providers": {
        "WebKit": {
          "libraries": [
            "webkit2gtk-4.1",
            "javascriptcoregtk-4.1",
            "gtk-3",
            "gdk-3",
            "gobject-2.0",
            "glib-2.0",
            "X11",
            "c"
          ]
        }
      }
    },
    "windows-x64": {
      "providers": {
        "WebView2": {
          "archive": "Boundary/windows-x64/WebView2LoaderStatic.lib",
          "libraries": ["advapi32", "kernel32", "ole32", "shell32", "shlwapi", "user32", "version"]
        }
      }
    },
    "windows-arm64": {
      "providers": {
        "WebView2": {
          "archive": "Boundary/windows-arm64/WebView2LoaderStatic.lib",
          "libraries": ["advapi32", "kernel32", "ole32", "shell32", "shlwapi", "user32", "version"]
        }
      }
    }
  }
}
