use GFX.Audio as GFXAudio
use GFX.Canvas
use GFX.Font as VectorFont
use GFX.Plugins
use GFX.WebView
use Image
use Image.JPEG
use Image.WebP
use STD.Math

func required_face(result:Result<VectorFont.Face, VectorFont.Error>) VectorFont.Face {
    match result {
        failure(error) => { panic(error.detail) }
        success(face) => { return face }
    }
}

func required_instance(result:Result<VectorFont.Instance, VectorFont.Error>) VectorFont.Instance {
    match result {
        failure(error) => { panic(error.detail) }
        success(instance) => { return instance }
    }
}

func required_run(result:Result<VectorFont.GlyphRun, VectorFont.Error>) VectorFont.GlyphRun {
    match result {
        failure(error) => { panic(error.detail) }
        success(run) => { return run }
    }
}

func required_glyph(result:Result<VectorFont.GlyphCoverage?, VectorFont.Error>) VectorFont.GlyphCoverage {
    match result {
        failure(error) => { panic(error.detail) }
        success(coverage) => {
            if value = coverage { return value }
            panic("expected glyph coverage")
        }
    }
}

test "compose GFX.Audio through its public API" {
    let playback = GFXAudio.Playback(
        volume:0.5,
        repeat:GFXAudio.Repeat.times(2)
    )
    assert(playback.volume == 0.5)
}

test "shape and rasterize GFX.Font through its public API" {
    var face = required_face(VectorFont.Face.default())
    var instance = required_instance(VectorFont.Instance.create(face, size:12.0))
    var run = required_run(instance.shape("Silex"))
    let glyphs = run.glyphs()
    assert(glyphs.count() > 0)
    let raster = required_glyph(instance.rasterize_glyph(glyphs[0].id))
    assert(!raster.is_empty())
}

test "compose GFX.Canvas and GFX.Font through their public APIs" {
    var font = Canvas.Font(required_face(VectorFont.Face.default()))
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "Silex",
            Math.Vec2(1.0),
            Canvas.TextStyle(size:12.0, font:font)
        )
    })
    let raster = drawing.rasterize(48, 20)
    assert(raster.width() == 48)
    assert(raster.height() == 20)
}

test "compose Image codecs through their public APIs" {
    var bitmap = Image.canvas(2, 2, Image.Color(120, 80, 40))
    let jpeg = Image.encode(bitmap, JPEG.Options(quality:90))
    let webp = Image.encode(bitmap, WebP.Options(lossless:true))
    assert(Image.decode(jpeg).width() == 2)
    assert(Image.decode(webp).height() == 2)
}

test "compose GFX.WebView through its public plugin API" {
    let site = WebView.Site.html("<!doctype html><html></html>")
    let plugin = Plugins.WebView(site)
    assert(plugin.id() == "GFX.WebView.Plugin")
}
