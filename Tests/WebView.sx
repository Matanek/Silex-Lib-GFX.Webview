use GFX.Window
use GFX.Color
use GFX.Input
use GFX.WebView

test "attach a system WebView to a GFX window" {
    var window = Window(Window.Settings(
        title:"GFX.WebView native smoke",
        width:320,
        height:240,
        hidden:true
    ))
    print("GFX_WEBVIEW_CHECKPOINT window-ready")
    var site = WebView.Site.html(embed_text("Fixtures/index.html"))
    site.add(WebView.Asset.css(embed_text("Fixtures/app.css"), path:"/app.css"))
    site.add(WebView.Asset.javascript(embed_text("Fixtures/app.js")))
    print("GFX_WEBVIEW_CHECKPOINT site-ready")

    var view = WebView.View(window, site)
    print("GFX_WEBVIEW_CHECKPOINT view-ready")
    var input = Input()
    var ready_attempts = 0
    while view.status() == WebView.Status.loading && ready_attempts < 250 {
        input.wait(4)
        input.update()
        ready_attempts++
    }
    assert(view.is_visible())
    assert(view.status() == WebView.Status.ready)
    print("GFX_WEBVIEW_CHECKPOINT document-ready")

    let message_count = 256
    view.send("context-menu-state")
    view.send("inline-ping", "inline script connected")
    for index in 0...message_count { view.send("ping", "$(index)") }
    assert(view.flush())
    print("GFX_WEBVIEW_CHECKPOINT bridge-flushed")

    var received = 0
    var context_menu_disabled = false
    var inline_script_connected = false
    var bridge_attempts = 0
    while (received < message_count || !context_menu_disabled || !inline_script_connected) && bridge_attempts < 500 {
        input.wait(4)
        input.update()
        for message in view.receive() {
            if message.name == "context-menu-state" {
                assert(message.payload == "disabled")
                context_menu_disabled = true
            } elif message.name == "inline-pong" {
                assert(message.payload == "inline script connected")
                inline_script_connected = true
            } else {
                assert(message.name == "pong")
                assert(message.payload == "$(received)")
                received++
            }
        }
        bridge_attempts++
    }
    assert(received == message_count)
    assert(context_menu_disabled)
    assert(inline_script_connected)
    print("GFX_WEBVIEW_CHECKPOINT bridge-received")

    view.set_visible(false)
    assert(!view.is_visible())
    view.set_visible(true)
    view.set_background(Color.blue_100())
    view.reload()
    assert(view.status() == WebView.Status.loading || view.status() == WebView.Status.ready)
    print("GFX_WEBVIEW_CHECKPOINT reload-ready")

}
