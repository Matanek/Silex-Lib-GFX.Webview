// Temporary target-complete adapter. It remains unavailable until Silex can
// resolve a user-installed WebView2 loader and implement its asynchronous COM
// callbacks without shipping WebView2Loader.dll in this package.
func available() bool { return false }

func unavailable_reason() str {
    return "the Windows adapter requires WebView2Loader in addition to the installed WebView2 runtime; " +
        "GFX.WebView does not distribute that architecture-specific third-party binary"
}

func create(
    window:uint,
    document:str,
    initialization_script:str,
    bridge_context:uint,
    bridge_callback:uint
) uint {
    unavailable()
    return 0 as uint
}

func bridge_script() str { return "window.__silexPost=message=>{};" }

func send(view:uint, encoded_batch:str) bool { return false }

func message_context(handler:uint) uint { return 0 as uint }
func message_text(message:uint) str { return "" }

func load(view:uint, document:str) bool {
    unavailable()
    return false
}

func set_visible(view:uint, visible:bool) {
    unavailable()
}

func is_visible(view:uint) bool {
    unavailable()
    return false
}

func loading(view:uint) bool {
    unavailable()
    return false
}

func set_background(window:uint, view:uint, red:float, green:float, blue:float, alpha:float) {
    unavailable()
}

func simulate_close_request(window:uint) {
    unavailable()
}

func destroy(view:uint) {
    if view != 0 as uint { unavailable() }
}

func unavailable() {
    panic(
        "GFX.WebView on Windows needs a system-resolved WebView2 loader and COM callback support; " +
        "GFX.WebView will not hide WebView2Loader.dll in a package Boundary"
    )
}
