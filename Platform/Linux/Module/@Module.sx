let gtk_widget_get_window = C.function<func(uint) uint>(library:Boundary.WebKit, name:"gtk_widget_get_window")
let gtk_widget_get_display = C.function<func(uint) uint>(library:Boundary.WebKit, name:"gtk_widget_get_display")
let gdk_x11_display_get_xdisplay = C.function<func(uint) uint>(library:Boundary.WebKit, name:"gdk_x11_display_get_xdisplay")
let gdk_x11_window_get_xid = C.function<func(uint) uint>(library:Boundary.WebKit, name:"gdk_x11_window_get_xid")
let XGetWindowAttributes = C.function<func(uint, uint, uint) int32>(library:Boundary.WebKit, name:"XGetWindowAttributes")
let XReparentWindow = C.function<func(uint, uint, uint, int32, int32) int32>(library:Boundary.WebKit, name:"XReparentWindow")
